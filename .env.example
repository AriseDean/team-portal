# Copy to .env and edit. Never commit .env.

# --- Required ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Your public hostname(s), comma separated
ALLOWED_HOSTS=teams.example.com
CSRF_TRUSTED_ORIGINS=https://teams.example.com
# Used for links in emails
SITE_URL=https://teams.example.com

# --- First admin account (created on first start only) -----------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Hosting ------------------------------------------------------------------
# Hostname for the bundled Caddy proxy (profile "caddy")
DOMAIN=teams.example.com
# Host port the app listens on (bound to 127.0.0.1)
PORT=8000
# 1 when users reach the site over HTTPS (set 0 only for plain-HTTP testing)
HTTPS=1
# 1 when behind your own reverse proxy that sets X-Forwarded-For
TRUST_PROXY=1
# Optional: move the admin away from /admin/
ADMIN_URL=admin/
TIME_ZONE=Asia/Kolkata

# --- Behaviour ------------------------------------------------------------------
TEAM_ID_PREFIX=TM
# Restrict registration to institute email domains (comma separated, empty = any)
ALLOWED_EMAIL_DOMAINS=
# Enrolment pattern (upper-case letters/digits, 5-20 chars by default). Set ENROLMENT_REGEX to
# change it; in this file a literal $ must be written as $$ (Docker Compose).

# --- Email ---------------------------------------------------------------------------
# OFF by default: nothing is emailed; students see their Team ID + PIN on screen and you reset lost
# PINs in the admin. To enable later set EMAIL_ENABLED=1 and fill in the values below
# (see SETUP.md, "Optional: turn email on later").
EMAIL_ENABLED=0
# NOTE: DigitalOcean blocks outbound SMTP ports 25, 465 and 587. Use port 2525 with a relay
# that supports it (example below: Brevo's free plan, 300 emails/day).
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#EMAIL_HOST=smtp-relay.brevo.com
#EMAIL_PORT=2525
#EMAIL_USE_TLS=1
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#DEFAULT_FROM_EMAIL=Team Portal <noreply@teams.example.com>
# all    = every team member gets team emails
# leader = only the team leader (use this on plans with a low daily cap)
#EMAIL_RECIPIENTS=all
# Seconds to wait for the mail server (a blocked port can never hang a page); sent in the background
#EMAIL_TIMEOUT=10
#EMAIL_ASYNC=1

# Optional: HSTS max-age in seconds once you're sure HTTPS works (e.g. 31536000)
HSTS_SECONDS=0

# --- Virus scan of uploads (optional, off by default) --------------------------------
# Run the scanner with `docker compose --profile av up -d` (about 1.5 GB RAM), then set:
#CLAMAV_HOST=clamav
#CLAMAV_REQUIRED=1   # 1 = refuse uploads if the scanner is down; 0 = let them through unscanned
